rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.userId == null);
    }
    match /meeting_inquiries/{inquiryId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }
    match /group_orders/{orderId} {
      allow read: if true;
      allow create: if true;
    }
    match /partnerships/{partnershipId} {
      allow read: if true;
      allow create: if true;
    }
    match /claimed_coupons/{couponId} {
      allow read, write: if true;
    }
  }
}
